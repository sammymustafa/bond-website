# eslint-config-next pulls in eslint-plugin-react, eslint-plugin-import and
# eslint-plugin-jsx-a11y, whose peer ranges stop at eslint 9, while this repo
# runs eslint 10. package-lock.json was resolved with legacy peer deps, so
# `npm ci` needs this setting to match it. Drop it once those plugins declare
# eslint 10 and the lockfile has been regenerated without it.
legacy-peer-deps=true
