// Cloudflare Workers config for bondtrials.com. `opennextjs-cloudflare build` turns the
// Next.js build into .open-next/ (the Worker plus its static assets); `deploy` uploads it.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bond-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Images, used by /_next/image to resize and convert to WebP. Without it
  // OpenNext serves the original file. Billed per unique transformation (5,000 a month
  // free); the whole site uses about 35 size variants.
  "images": {
    "binding": "IMAGES"
  },
  // The bondtrials.com and www.bondtrials.com custom domains are attached in the dashboard
  // (Worker > Domains), not listed here, so no deploy can move them by accident.
  "workers_dev": true,
  // The bundled Next.js server is ~11 MB; minifying cuts the upload and the cold-start
  // parse time. Source maps keep stack traces in Workers Logs readable.
  "minify": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  }
}
